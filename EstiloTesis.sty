\newcommand{\transformer}[1][1]{%
    \begin{tikzpicture}[
        scale=#1,
        transform shape,
        block/.style={rectangle, draw, thick, minimum width=1.2cm, minimum height=0.8cm, font=\small, align=center},
        blockwide/.style={rectangle, draw, thick, minimum width=2.5cm, minimum height=0.8cm, font=\small, align=center},
        blocksmall/.style={rectangle, draw, thick, minimum width=0.8cm, minimum height=0.6cm, font=\scriptsize},
        arrow/.style={->, >=stealth, thick},
        dashedline/.style={dashed, thick},
        label/.style={font=\scriptsize}
    ]

    % Títulos principales
    \node[font=\large\bfseries] at (3, 8.5) {Encoder};
    \node[font=\large\bfseries] at (11, 8.5) {Decoder};

    % Línea divisoria vertical
    \draw[dashedline] (7.5, -0.5) -- (7.5, 8.5);

    % ==================== ENCODER ====================

    % Input Embeddings
    \node[blockwide, fill=gray!20] (input) at (1.5, 0) {Overlap Patch\\Embeddings};
    \draw[arrow] (0, 0) -- (input.west);

    % Bloque Efficient Self-Attention
    \node[blockwide, fill=green!20] (selfattn) at (3, 1.5) {Efficient\\Self-Attn};
    \node[block, fill=white] (mixffn) at (4.5, 1.5) {Mix-FFN};
    \node[blockwide, fill=pink!30] (patchmerge) at (3.5, 3) {Overlap Patch\\Merging};

    % Conexiones encoder inferior
    \draw[arrow] (input.north) -- (1.5, 1.5) -- (selfattn.west);
    \draw[arrow] (selfattn.east) -- (mixffn.west);
    \draw[arrow] (mixffn.north) -- (4.5, 3) -- (patchmerge.east);

    \node[label] at (1, 2.5) {$\times N$};

    % Transformer Blocks - Encoder
    \node[block, fill=orange!60, minimum height=1.5cm] (trans1) at (2, 5) {Transformer\\Block 1};
    \node[block, fill=orange!60, minimum height=1.5cm] (trans2) at (3.5, 5) {Transformer\\Block 2};
    \node[block, fill=orange!60, minimum height=1.5cm] (trans3) at (5, 5) {Transformer\\Block 3};
    \node[block, fill=orange!60, minimum height=1.5cm] (trans4) at (6.5, 5) {Transformer\\Block 4};

    % Etiquetas superiores encoder
    \node[label] at (2, 7.8) {$\frac{H}{4} \times \frac{W}{4} \times C_1$};
    \node[label] at (3.5, 7.8) {$\frac{H}{8} \times \frac{W}{8} \times C_2$};
    \node[label] at (5, 7.8) {$\frac{H}{16} \times \frac{W}{16} \times C_3$};
    \node[label] at (6.5, 7.8) {$\frac{H}{32} \times \frac{W}{32} \times C_4$};

    % Conexiones horizontales encoder
    \draw[arrow] (patchmerge.north) -- (2, 4);
    \draw[arrow] (trans1.north) -- (2, 6.5) -- (3.5, 6.5) -- (trans2.north);
    \draw[arrow] (trans2.north) -- (3.5, 6.5) -- (5, 6.5) -- (trans3.north);
    \draw[arrow] (trans3.north) -- (5, 6.5) -- (6.5, 6.5) -- (trans4.north);

    % ==================== DECODER ====================

    % MLP superior
    \node[block, fill=cyan!30, minimum height=1.5cm] (mlp) at (13.5, 5) {MLP};
    \draw[arrow] (mlp.east) -- (14.5, 5);

    % Transformer y operaciones decoder
    \node[block, fill=orange!60, minimum height=1.5cm] (trans5) at (10, 5) {Transformer\\Block 4};
    \node[blocksmall, fill=white] (plus1) at (11.5, 5) {$+$};
    \node[blocksmall, fill=white] (plus2) at (12.5, 5) {$+$};

    % Etiquetas superiores decoder
    \node[label] at (10, 7.8) {$\frac{H}{4} \times \frac{W}{4} \times C$};
    \node[label] at (11.5, 7.8) {$4C$};
    \node[label] at (13.5, 7.8) {$\frac{H}{4} \times \frac{W}{4} \times N_{cls}$};

    % Conexiones decoder superior
    \draw[arrow] (trans5.north) -- (10, 6.5) -- (plus1.north);
    \draw[arrow] (plus1.east) -- (plus2.west);
    \draw[arrow] (plus2.east) -- (mlp.west);

    % Bloques centrales decoder
    \node[blockwide, fill=white] (mlplayer) at (10.5, 2.5) {MLP\\LAYER};
    \node[blockwide, fill=white] (upsample) at (12.5, 2.5) {Upsample};
    \node[block, fill=cyan!30] (mlpbottom) at (12.5, 0.8) {MLP};

    % Conexiones decoder
    \draw[arrow] (mlplayer.east) -- (upsample.west);
    \draw[arrow] (trans5.south) -- (10, 3.5) -- (mlplayer.north);
    \draw[arrow] (upsample.south) -- (12.5, 1.2);
    \draw[arrow] (mlpbottom.south) -- (12.5, 0);

    % Etiquetas inferiores decoder
    \node[label] at (9, 2) {$\frac{H}{2^{i+1}} \times \frac{W}{2^{i+1}} \times C_i$};
    \node[label] at (10.5, 1.5) {$\frac{H}{2^{i+1}} \times \frac{W}{2^{i+1}} \times C$};
    \node[label] at (12.5, 1.5) {$\frac{H}{2^i} \times \frac{W}{2^i} \times C$};

    % Conexión cruzada encoder-decoder
    \draw[arrow, thick] (trans4.east) -- (7.5, 5) -- (7.5, 2.5) -- (mlplayer.west);

    % Entrada decoder
    \draw[arrow] (8, 0.8) -- (mlpbottom.west);

    \end{tikzpicture}%
}

\newcommand{\precisionGeometrica}[2][1]{
    \begin{tikzpicture}[scale=#1, transform shape]
        \def\cuadro{#2}

        % ==================== POOR ====================
        \begin{scope}[shift={(0,0)}]
            % Cuadrado azul grande (objetivo/target)
            \draw[blue!70, line width=2pt] (0,0) rectangle (\cuadro,\cuadro);

            % Cuadrado rojo pequeño desplazado (resultado)
            \draw[red!70, line width=2pt]
                (0,\cuadro*0.6) rectangle (\cuadro*0.4,\cuadro);

            % Etiqueta
            \node[font=\large\bfseries] at (\cuadro/2, -0.6) {Pobre};
        \end{scope}

        % ==================== GOOD ====================
        \begin{scope}[shift={(\cuadro+1.5,0)}]
            % Cuadrado azul (objetivo/target)
            \draw[blue!70, line width=2pt] (0,0) rectangle (\cuadro,\cuadro);

            % Cuadrado rojo ligeramente desplazado (resultado)
            \draw[red!70, line width=2pt]
                (\cuadro*0.1,\cuadro*0.1) rectangle (\cuadro*0.9,\cuadro*0.9);

            % Etiqueta
            \node[font=\large\bfseries] at (\cuadro/2, -0.6) {Bueno};
        \end{scope}

        % ==================== EXCELLENT ====================
        \begin{scope}[shift={(2*\cuadro+3,0)}]
            % Cuadrado azul (objetivo/target)
            \draw[blue!70, line width=2pt] (0,0) rectangle (\cuadro,\cuadro);

            % Cuadrado rojo casi perfecto (resultado)
            \draw[red!70, line width=2pt]
                (\cuadro*0.02,\cuadro*0.02) rectangle (\cuadro*0.98,\cuadro*0.98);

            % Etiqueta
            \node[font=\large\bfseries] at (\cuadro/2, -0.6) {Excelente};
        \end{scope}

    \end{tikzpicture}
}

