\makeatletter
\def\ps@lscapeheader{%
    \let\@mkboth\@gobbletwo

    % === PIE DE PÁGINA (número horizontal en la esquina inferior derecha) ===
    \def\@oddfoot{%
        \begin{tikzpicture}[remember picture, overlay]
            % Número de página horizontal (NO rotado)
            \node[anchor=south east] at ([xshift=-1cm, yshift=1cm]current page.south east) {%
                \begin{minipage}{3cm}
                    \raggedleft
                    {\color{Grey}\rule{2cm}{1.3pt}}%
                    \hspace{5pt}%
                    {\color{Grey}\normalsize\textbf{\thepage}}%
                \end{minipage}
            };
        \end{tikzpicture}%
    }%

    % === ENCABEZADO ROTADO 90° (lado izquierdo en landscape) ===
    \def\@oddhead{%
        \begin{tikzpicture}[remember picture, overlay]
            % Línea principal horizontal (que se verá vertical en landscape)
            \draw[line width=1pt, Grey]
                ([xshift=0.8cm, yshift=-2cm]current page.north west) --
                ([xshift=0.8cm, yshift=2cm]current page.south west);

            % Cuadrados decorativos en los extremos
            \fill[Grey] ([xshift=0.725cm, yshift=-2cm]current page.north west) rectangle ++(0.15,0.15);
            \fill[Grey] ([xshift=0.725cm, yshift=2.15cm]current page.south west) rectangle ++(0.15,0.15);

            % Línea secundaria delgada
            \draw[line width=0.3pt, Grey!50]
                ([xshift=0.72cm, yshift=-1.8cm]current page.north west) --
                ([xshift=0.72cm, yshift=1.8cm]current page.south west);

            % Texto del capítulo rotado 90°
            \node[rotate=90, anchor=south] at ([xshift=1.5cm, yshift=0cm]current page.west) {%
                \scriptsize\color{Grey}\leftmark%
            };
        \end{tikzpicture}%
    }%

    \let\@evenfoot\@oddfoot
    \let\@evenhead\@oddhead
}
