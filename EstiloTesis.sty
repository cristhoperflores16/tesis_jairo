\newcommand{\neuronacompleta}[3][1]{%
    \begin{tikzpicture}[
        scale=#1,
        input/.style={circle, draw, fill=yellow!50, minimum size=0.3cm},
        synapse/.style={->, >=stealth, thick},
        node/.style={circle, draw, thick, minimum size=1.5cm, font=\Large},
        block/.style={rectangle, draw, thick, minimum width=1cm, minimum height=1cm, font=\large},
        label/.style={font=\normalsize}
    ]

    % Título
    \node[font=\large\bfseries] at (4, 3.5) {NEURONA #3};

    % Calcular espaciado vertical
    \pgfmathsetmacro{\spacing}{6/(#2+1)}

    % Entradas (dendritas)
    \foreach \i in {1,...,#2} {
        \pgfmathsetmacro{\y}{5.5 - \i*\spacing}
        \node[input] (x\i) at (-2, \y) {};

        % Etiquetas especiales para primera y última entrada
        \ifnum\i=1
            \node[label, left] at (x\i.west) {$x_1$};
        \else\ifnum\i=2
            \node[label, left] at (x\i.west) {$x_2$};
        \else\ifnum\i=#2
            \node[label, left] at (x\i.west) {$x_n$};
        \else
            \node[label, left] at (x\i.west) {$x_{\i}$};
        \fi\fi\fi

        % Línea de sinapsis con etiquetas
        \ifnum\i=1
            \draw[synapse] (x\i) -- node[above, sloped, font=\small] {$w_{#3 1}$} (2.1, 1.5);
        \else\ifnum\i=2
            \draw[synapse] (x\i) -- node[above, sloped, font=\small] {$w_{#3 2}$} (2.1, 1.5);
        \else\ifnum\i=#2
            \draw[synapse] (x\i) -- node[above, sloped, font=\small] {$w_{#3 n}$} (2.1, 1.5);
        \else
            \draw[synapse] (x\i) -- node[above, sloped, font=\small] {$w_{#3\i}$} (2.1, 1.5);
        \fi\fi\fi
    }

    % Puntos suspensivos si hay más de 3 entradas
    \ifnum#2>3
        \node at (-2.3, 2.5) {$\vdots$};
        \node[label] at (-0.8, 2.5) {$\vdots$};
    \fi

    % Entrada umbral
    \node[input] (theta) at (3, -0.5) {};
    \node[label, below] at (theta.south) {Umbral};
    \node[label, left] at (theta.west) {$\theta_{#3}$};
    \draw[synapse] (theta) -- (3, 1.5);

    % Cuerpo (sumador) %CIRCULO QUE CONTIENE LA SUMATORIA
    \node[node] (sum) at (3, 1.5) {$\Sigma$};
    \node[label, above] at (sum.north) {Cuerpo};

    % Función de activación %CUADRO QUE CONTIENE LA FUNCION
    \node[block] (activation) at (5.5, 1.5) {$f()$};

    % Salida (axón)
    \draw[synapse] (sum) -- (activation);
    \draw[synapse] (activation) -- node[above, font=\small] {Axón} (9, 1.5); %FLECHA DEL AXON
    \node[label, right] at (9, 1.0) {$y_{#3}$};
    \node[label, above right] at (8.5, 2.0) {Salida};

    % Etiquetas adicionales
    \node[label] at (-2, 5.8) {Entradas};
    \node[label] at (-0.5, 5.3) {sinapsis};
    \node[label] at (-2, -1) {Dendritas};

    \end{tikzpicture}
}

