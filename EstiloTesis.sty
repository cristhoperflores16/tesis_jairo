%GRAFICOS PAVIMENTOS FLEXIBLE
% En EstiloTesis.sty
% Parámetros: [escala global]{ancho}{mostrar flechas}
% escala: número (default 1)
% ancho: número en cm (default 8)
% mostrar flechas: true/false (default true)
\newcommand{\diagramaPavimento}[3][1]{
    \begin{tikzpicture}[scale=#1]
        % Definir colores
        \definecolor{asfalto}{RGB}{74,74,74}
        \definecolor{base}{RGB}{212,163,115}
        \definecolor{subbase}{RGB}{232,213,183}
        \definecolor{subrasante}{RGB}{193,154,107}
        \def\ancho{#2}
        \def\mostrarFlechas{#3}
        % Subrasante
        \fill[subrasante] (0,0) rectangle (\ancho,2);
