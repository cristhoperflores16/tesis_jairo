% Comando para crear el cronograma de investigación (Nov 2025 - Ene 2026)
\newcommand{\cronogramaInvestigacion}[1][1]{%
    \begin{tikzpicture}[scale=#1, transform shape]

        % Definir colores
        \definecolor{azul1}{RGB}{150,180,230}
        \definecolor{azul2}{RGB}{100,140,220}
        \definecolor{rosa}{RGB}{255,180,180}
        \definecolor{naranja}{RGB}{255,200,130}
        \definecolor{verde1}{RGB}{180,230,180}
        \definecolor{verde2}{RGB}{140,220,140}

        % Círculos superiores (Trabajos preliminares) - Centrados en y=0.4
        \fill[azul2, opacity=0.6] (3,0.4) circle (1.2cm);
        \fill[azul1, opacity=0.6] (5.5,0.4) circle (1.8cm);
        \fill[azul2, opacity=0.6] (8,0.4) circle (1.5cm);

        % Círculos inferiores (Informe de tesis) - Centrados en y=0.4
        \fill[rosa, opacity=0.6] (9.5,0.4) circle (1.3cm);
        \fill[rosa, opacity=0.6] (10.5,0.4) circle (1cm);
        \fill[naranja, opacity=0.6] (11.2,0.4) circle (0.8cm);
        \fill[verde1, opacity=0.6] (11.8,0.4) circle (1.5cm);
        \fill[verde2, opacity=0.6] (12.5,0.4) circle (1.3cm);

        % Barra de tiempo (línea base) - Centro en y=0.4
        \fill[Grey!80] (0.3,0) rectangle (14,0.8);

        % Año 2025 (izquierda)
        \node[white, font=\Large\bfseries] at (1,0.4) {2025};

        % Meses
        \node[white, font=\normalsize] at (5,0.4) {Noviembre};
        \node[white, font=\normalsize] at (9,0.4) {Diciembre};
        \node[white, font=\normalsize] at (11.5,0.4) {Enero};

        % Año 2026 (derecha)
        \node[white, font=\Large\bfseries] at (13,0.4) {2026};

        % ============ ETIQUETAS SUPERIORES CON LÍNEAS INCLINADAS ============

        % Inicio (círculo azul pequeño izquierda)
        \fill (2.2,1.2) circle (2pt);
        \draw[thick] (2.2,1.2) -- (1.5,2.5) node[above, align=center, font=\scriptsize] {Inicio};

        % Recopilación de información (círculo azul grande)
        \fill (4.5,1.8) circle (2pt);
        \draw[thick] (4.5,1.8) -- (3.5,3.2) node[above, align=center, font=\scriptsize] {Recopilación de\\información};

        % Organización y resumen (círculo azul grande centro)
        \fill (6.5,1.8) circle (2pt);
        \draw[thick] (6.5,1.8) -- (6,3.6) node[above, align=center, font=\scriptsize] {Organización y\\resumen de\\información};

        % Aprobación de plan de tesis (círculo azul medio derecha)
        \fill (8.8,1.7) circle (2pt);
        \draw[thick] (8.8,1.7) -- (9.5,3.2) node[above, align=center, font=\scriptsize] {Aprobación de\\plan de tesis};

