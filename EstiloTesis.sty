%\RequirePackage{hyperref}
\xpatchbibdriver{article,book}{%
    \usebibmacro{note+pages}
    }{%
    \usebibmacro{note+pages}
    \setunit*{\mdseries\addcomma\space}
    \usebibmacro{date}}
    {}
    {}

    \DeclareFieldFormat{title}{#1}
    \renewcommand{\multinamedelim}{\nopunct\addspace}
    \renewcommand{\finalnamedelim}{\adddot\addspace}
    \renewcommand*{\labelnamepunct}{\addspace}
%
    \DeclareNameAlias{default}{last-first}
%
    \DeclareFieldFormat
%        [book,article,inbook,incollection,inproceedings,patent,thesis,unpublished]
        {title}{\textit{#1}\isdot}

    \DeclareFieldFormat
        {issuetitle}{\mkbibparens{#1}}
%
    \renewbibmacro*{in:}{}

    %\renewbibmacro*{date}{%
        %\mkbibbold{\printdate}}%
    \renewbibmacro*{journal+issuetitle}{%
        \usebibmacro{journal}%
        \setunit*{\addcomma\space}%
        \iffieldundef{series}
        {}
        {\newunit
        \printfield{series}%
        \setunit{\addspace}}%
        \usebibmacro{volume+number+eid}%
        \setunit{\addspace}%
        \usebibmacro{issue}%
        \setunit*{\addcomma\space}
        \newunit}

    \newbibmacro*{volume+number+eid}{%
        \printfield{volume}%
        \setunit*{\addcomma\space}%
        \printfield{number}%
        \setunit{\addcomma\space}%
        \printfield{eid}}

\DeclareFieldFormat[book,article,inbook,incollection,inproceedings,patent,thesis,unpublished]
        {volume}{%
            {{\small Vol.}#1}
            {\isdot}
            \isdot\space}

    \xapptobibmacro{journal}{\addsemicolon\addspace\printfield{year}}{\typeout{successfully patched bibmacro{journal} to include year}}{\typeout{failed to patch bibmacro{journal} to include year}}
    \xpretobibmacro{author}{\bgroup}{}{}%
    \xapptobibmacro{author}{\egroup}{}{}%
    \xpretobibmacro{journal}{\bgroup}{}{}%
    \xapptobibmacro{journal}{\egroup}{}{}%


\newtoggle{myintextcite}
